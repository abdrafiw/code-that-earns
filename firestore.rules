rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidRole(role) {
      return role == 'DEVELOPER' || role == 'COMPANY';
    }

    function hasValidProfileName(data) {
      return (data.role == 'DEVELOPER'
          && data.name is string
          && data.name.size() > 0
          && !data.keys().hasAny(['companyName']))
        || (data.role == 'COMPANY'
          && data.companyName is string
          && data.companyName.size() > 0
          && !data.keys().hasAny(['name']));
    }

    function changesOnlyEditableProfileFields() {
      return (resource.data.role == 'DEVELOPER'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt']))
        || (resource.data.role == 'COMPANY'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['companyName', 'updatedAt']));
    }

    function hasValidSubmissionFields(submissionId, data) {
      let challenge = get(/databases/$(database)/documents/challenges/$(data.challengeId)).data;
      let developer = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return submissionId == data.challengeId + '_' + request.auth.uid
        && data.keys().hasOnly([
          'schemaVersion', 'challengeId', 'companyUid', 'challengeTitle', 'challengeDescription',
          'challengeOutcome', 'submissionUrl', 'liveDemoUrl', 'notes', 'publicWinnerConsent', 'developerUid',
          'developerName', 'developerEmail', 'status', 'createdAt'
        ])
        && data.schemaVersion == 3
        && data.challengeId is string
        && data.developerUid == request.auth.uid
        && data.companyUid == challenge.companyUid
        && data.challengeTitle == challenge.title
        && data.challengeDescription == challenge.description
        && data.challengeOutcome == challenge.outcome
        && data.developerName == developer.name
        && data.developerEmail == developer.email
        && data.submissionUrl is string
        && data.submissionUrl.size() <= 2048
        && ((challenge.category == 'UI/UX Design'
            && (data.submissionUrl.matches('^https://(www[.])?figma[.]com/(design|file|proto|board)/[^/]+.*')
              || data.submissionUrl.matches('^https://(www[.])?figma[.]com/community/file/[^/]+.*')
              || data.submissionUrl.matches('^https://(www[.])?behance[.]net/gallery/[^/]+/[^/]+.*')
              || data.submissionUrl.matches('^https://(www[.])?dribbble[.]com/shots/[^/]+.*')))
          || (challenge.category != 'UI/UX Design'
            && data.submissionUrl.matches('^https://github[.]com/[^/]+/[^/]+/?$')))
        && (!data.keys().hasAny(['liveDemoUrl']) || (data.liveDemoUrl is string && data.liveDemoUrl.size() <= 2048 && data.liveDemoUrl.matches('^https://.+')))
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && data.publicWinnerConsent is bool
        && data.status == 'submitted'
        && data.createdAt == request.time
        && challenge.deadline > request.time
        && (!challenge.keys().hasAny(['status']) || challenge.status == 'open');
    }

    function hasValidSubmissionStatusTransition(currentStatus, nextStatus) {
      return currentStatus == nextStatus
        || (currentStatus == 'submitted'
          && nextStatus in ['under_review', 'rejected'])
        || (currentStatus == 'under_review' && nextStatus == 'rejected');
    }

    function hasValidSubmissionReview(data) {
      return data.status in ['submitted', 'under_review', 'rejected']
        && data.reviewedAt == request.time
        && (!data.keys().hasAny(['reviewNotes'])
          || (data.reviewNotes is string && data.reviewNotes.size() <= 2000))
        && (!data.keys().hasAny(['score'])
          || (data.score is number && data.score >= 0 && data.score <= 100));
    }
    
    // Users collection
    match /users/{userId} {
      // User documents contain private account data. Public display data needed
      // by another party is stored as a bounded projection on domain records.
      allow get: if isOwner(userId);
      allow list: if false;
      
      // Users can create their own profile during signup
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'role', 'name', 'companyName', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && hasValidRole(request.resource.data.role)
        && hasValidProfileName(request.resource.data)
        && request.resource.data.createdAt == request.time;
      
      // Users can update their own profile
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && changesOnlyEditableProfileFields()
        && hasValidProfileName(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }
    
    // Challenges collection
    match /challenges/{challengeId} {
      // Anyone authenticated can read challenges
      allow read: if isAuthenticated();
      
      // Publication is performed by the trusted backend Admin SDK.
      allow create: if false;
      
      // Only the creator can update their own challenges
      allow update: if isAuthenticated() 
        && resource.data.companyUid == request.auth.uid
        && request.resource.data.companyUid == resource.data.companyUid
        && request.resource.data.companyName == resource.data.companyName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status == 'open'
        && request.resource.data.status in ['in_review', 'cancelled']
        && request.resource.data.updatedAt == request.time;
      
      allow delete: if false;
    }
    
    // Submissions collection
    match /submissions/{submissionId} {
      // Developers can read their own submissions
      allow read: if isAuthenticated() 
        && (resource.data.developerUid == request.auth.uid 
            || resource.data.companyUid == request.auth.uid
            || exists(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
            && get(/databases/$(database)/documents/challenges/$(resource.data.challengeId)).data.companyUid == request.auth.uid);
      
      // Only developers can create submissions
      allow create: if isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER'
        && exists(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
        && hasValidSubmissionFields(submissionId, request.resource.data);
      
      // Companies can update submissions for their challenges
      allow update: if isAuthenticated() 
        && exists(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
        && get(/databases/$(database)/documents/challenges/$(resource.data.challengeId)).data.companyUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewNotes', 'reviewedAt', 'score'])
        && hasValidSubmissionStatusTransition(
          resource.data.status,
          request.resource.data.status
        )
        && hasValidSubmissionReview(request.resource.data);
    }
    
  }
}
