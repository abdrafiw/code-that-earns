rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidRole(role) {
      return role == 'DEVELOPER' || role == 'COMPANY';
    }

    function hasValidProfileName(data) {
      return (data.role == 'DEVELOPER'
          && data.name is string
          && data.name.size() > 0
          && !data.keys().hasAny(['companyName']))
        || (data.role == 'COMPANY'
          && data.companyName is string
          && data.companyName.size() > 0
          && !data.keys().hasAny(['name']));
    }

    function changesOnlyEditableProfileFields() {
      return (resource.data.role == 'DEVELOPER'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt']))
        || (resource.data.role == 'COMPANY'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['companyName', 'updatedAt']));
    }

    function hasValidChallengeFields(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'title', 'description', 'category', 'difficulty',
          'outcome', 'winnerCount', 'eligibility', 'geographicRestrictions',
          'deadline', 'searchTerms', 'searchSchemaVersion', 'filterFacets',
          'companyName', 'companyUid', 'status', 'submissions', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 2
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 5000
        && data.category in ['Coding', 'Data Analysis', 'Blockchain']
        && data.difficulty in ['Beginner', 'Intermediate', 'Advanced']
        && data.outcome is map
        && data.outcome.keys().hasOnly(['type', 'recognitionLabel', 'amountMinor', 'currency', 'rewardDescription', 'deliveryTerms'])
        && data.outcome.type in ['recognition', 'monetary', 'non_monetary', 'recognition_and_reward']
        && data.winnerCount is int && data.winnerCount >= 1 && data.winnerCount <= 10
        && data.eligibility is string && data.eligibility.size() > 0 && data.eligibility.size() <= 2000
        && data.geographicRestrictions is string && data.geographicRestrictions.size() > 0 && data.geographicRestrictions.size() <= 1000
        && (data.outcome.type != 'recognition' || (data.outcome.recognitionLabel is string && data.outcome.recognitionLabel.size() > 0))
        && (data.outcome.type != 'monetary' && data.outcome.type != 'recognition_and_reward' || (data.outcome.amountMinor is int && data.outcome.amountMinor > 0 && data.outcome.currency is string && data.outcome.currency.matches('^[A-Z]{3}$') && data.outcome.deliveryTerms is string && data.outcome.deliveryTerms.size() > 0))
        && (data.outcome.type != 'non_monetary' || (data.outcome.rewardDescription is string && data.outcome.rewardDescription.size() > 0 && data.outcome.deliveryTerms is string && data.outcome.deliveryTerms.size() > 0))
        && data.searchTerms is list
        && data.searchTerms.size() <= 100
        && data.searchSchemaVersion == 1
        && data.filterFacets is list
        && data.filterFacets.size() == 3
        && data.filterFacets.hasAll([
          'category:' + data.category,
          'difficulty:' + data.difficulty,
          'category:' + data.category + '|difficulty:' + data.difficulty
        ])
        && data.deadline is timestamp
        && data.deadline > request.time
        && data.status == 'open'
        && data.submissions == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidSubmissionFields(submissionId, data) {
      let challenge = get(/databases/$(database)/documents/challenges/$(data.challengeId)).data;
      let developer = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return submissionId == data.challengeId + '_' + request.auth.uid
        && data.keys().hasOnly([
          'schemaVersion', 'challengeId', 'companyUid', 'challengeTitle', 'challengeDescription',
          'challengeOutcome', 'githubUrl', 'liveDemoUrl', 'notes', 'publicWinnerConsent', 'developerUid',
          'developerName', 'developerEmail', 'status', 'createdAt'
        ])
        && data.schemaVersion == 2
        && data.challengeId is string
        && data.developerUid == request.auth.uid
        && data.companyUid == challenge.companyUid
        && data.challengeTitle == challenge.title
        && data.challengeDescription == challenge.description
        && data.challengeOutcome == challenge.outcome
        && data.developerName == developer.name
        && data.developerEmail == developer.email
        && data.githubUrl is string
        && data.githubUrl.matches('^https://github[.]com/[^/]+/[^/]+/?$')
        && (!data.keys().hasAny(['liveDemoUrl']) || (data.liveDemoUrl is string && data.liveDemoUrl.matches('^https://.+')))
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && data.publicWinnerConsent is bool
        && data.status == 'submitted'
        && data.createdAt == request.time
        && challenge.deadline > request.time
        && (!challenge.keys().hasAny(['status']) || challenge.status == 'open');
    }

    function hasValidSubmissionStatusTransition(currentStatus, nextStatus) {
      return currentStatus == nextStatus
        || (currentStatus == 'submitted'
          && nextStatus in ['under_review', 'rejected'])
        || (currentStatus == 'under_review' && nextStatus == 'rejected');
    }

    function hasValidSubmissionReview(data) {
      return data.status in ['submitted', 'under_review', 'rejected']
        && data.reviewedAt == request.time
        && (!data.keys().hasAny(['reviewNotes'])
          || (data.reviewNotes is string && data.reviewNotes.size() <= 2000))
        && (!data.keys().hasAny(['score'])
          || (data.score is number && data.score >= 0 && data.score <= 100));
    }
    
    // Users collection
    match /users/{userId} {
      // User documents contain private account data. Public display data needed
      // by another party is stored as a bounded projection on domain records.
      allow get: if isOwner(userId);
      allow list: if false;
      
      // Users can create their own profile during signup
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'role', 'name', 'companyName', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && hasValidRole(request.resource.data.role)
        && hasValidProfileName(request.resource.data)
        && request.resource.data.createdAt == request.time;
      
      // Users can update their own profile
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && changesOnlyEditableProfileFields()
        && hasValidProfileName(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }
    
    // Challenges collection
    match /challenges/{challengeId} {
      // Anyone authenticated can read challenges
      allow read: if isAuthenticated();
      
      // Only companies can create challenges
      allow create: if isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COMPANY'
        && request.resource.data.companyUid == request.auth.uid
        && request.resource.data.companyName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyName
        && hasValidChallengeFields(request.resource.data);
      
      // Only the creator can update their own challenges
      allow update: if isAuthenticated() 
        && resource.data.companyUid == request.auth.uid
        && request.resource.data.companyUid == resource.data.companyUid
        && request.resource.data.companyName == resource.data.companyName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status == 'open'
        && request.resource.data.status in ['in_review', 'cancelled']
        && request.resource.data.updatedAt == request.time;
      
      allow delete: if false;
    }
    
    // Submissions collection
    match /submissions/{submissionId} {
      // Developers can read their own submissions
      allow read: if isAuthenticated() 
        && (resource.data.developerUid == request.auth.uid 
            || resource.data.companyUid == request.auth.uid
            || exists(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
            && get(/databases/$(database)/documents/challenges/$(resource.data.challengeId)).data.companyUid == request.auth.uid);
      
      // Only developers can create submissions
      allow create: if isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER'
        && exists(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
        && hasValidSubmissionFields(submissionId, request.resource.data);
      
      // Companies can update submissions for their challenges
      allow update: if isAuthenticated() 
        && exists(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
        && get(/databases/$(database)/documents/challenges/$(resource.data.challengeId)).data.companyUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewNotes', 'reviewedAt', 'score'])
        && hasValidSubmissionStatusTransition(
          resource.data.status,
          request.resource.data.status
        )
        && hasValidSubmissionReview(request.resource.data);
    }
    
    match /transactions/{transactionId} { allow read, write: if false; }
  }
}
